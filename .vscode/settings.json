{
    "files.associations": {
        "*.ino": "cpp",
        "functional": "cpp",
        "array": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp"
    },
    "idf.pythonInstallPath": "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3",
    "C_Cpp.clang_format_style": "{ BreakBeforeBraces: Attach, ColumnLimit: 0, SortIncludes: false }",
    "cmake.ignoreCMakeListsMissing": true,
    "idf.showOnboardingOnInit": false,
    "idf.enableStatusBar": false
}